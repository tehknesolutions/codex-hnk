{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hnk.local/schemas/day-003.evidence.schema.json",
  "title":"HNK Day 003 Evidence V1",
  "type":"object",
  "additionalProperties":false,
  "required":["protocol_version","source_sha","session_id","jachin","boaz","middle","soul_mirror","voluntary_completion_confirmed"],
  "properties":{
    "protocol_version":{"const":"HNK-KETHER-D003-V1"},
    "source_sha":{"const":"3cb60ed208c24ee885cbe95d974c7468419120aa"},
    "session_id":{"type":"string","minLength":1},
    "mode":{"enum":["first_completion","revisit"]},
    "jachin":{
      "type":"object","additionalProperties":false,
      "required":["observation_completed","duration_seconds","beliefs_recorded_count","return_confirmed"],
      "properties":{
        "observation_completed":{"const":true},
        "duration_seconds":{"type":"integer","minimum":0},
        "thought_returns":{"type":"integer","minimum":0},
        "beliefs_recorded_count":{"type":"integer","minimum":3},
        "belief_reframe_completed":{"type":"boolean"},
        "vault_entry_ref":{"type":["string","null"]},
        "return_confirmed":{"const":true}
      }
    },
    "audio_theta432":{
      "type":"object","additionalProperties":false,
      "required":["started","profile_id"],
      "properties":{
        "started":{"const":true},
        "profile_id":{"const":"HNK-THETA432-BINAURAL-V1"},
        "duration_seconds":{"type":["integer","null"],"minimum":0},
        "stopped_for_discomfort":{"type":"boolean"}
      }
    },
    "boaz":{
      "type":"object","additionalProperties":false,
      "required":["relaxation_completed","protective_intention_inquiry_completed","real_world_action_id","challenge_completed","return_confirmed"],
      "properties":{
        "relaxation_completed":{"const":true},
        "protective_intention_inquiry_completed":{"const":true},
        "inquiry_vault_entry_ref":{"type":["string","null"]},
        "real_world_action_id":{"type":"string","format":"uuid"},
        "challenge_completed":{"const":true},
        "restart_count":{"type":"integer","minimum":0},
        "return_confirmed":{"const":true}
      }
    },
    "middle":{
      "type":"object","additionalProperties":false,
      "required":["completed","return_confirmed"],
      "properties":{
        "completed":{"const":true},
        "comfort_rating":{"type":["integer","null"],"minimum":0,"maximum":10},
        "return_confirmed":{"const":true}
      }
    },
    "phenomenology":{
      "type":"array","uniqueItems":true,
      "items":{"enum":["MANY_THOUGHTS","CALM","AGITATION","BODY_SENSATIONS","SILENCE","STRONG_EMOTION","NOTHING_SPECIAL","OTHER"]}
    },
    "soul_mirror":{
      "type":"object","additionalProperties":false,
      "required":["completed"],
      "properties":{
        "completed":{"const":true},
        "difficulty_rating":{"type":["integer","null"],"minimum":0,"maximum":10},
        "vault_entry_ref":{"type":["string","null"]}
      }
    },
    "voluntary_completion_confirmed":{"const":true},
    "safety_stop_occurred":{"type":"boolean"}
  }
}
