{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hnk.local/schemas/day-004.evidence.schema.json",
  "title":"HNK Day 004 Evidence V1",
  "type":"object",
  "additionalProperties":false,
  "required":["protocol_version","source_sha","session_id","experiment","jachin","audio_theta432","boaz","middle","soul_mirror","voluntary_completion_confirmed"],
  "properties":{
    "protocol_version":{"const":"HNK-KETHER-D004-V1"},
    "source_sha":{"const":"376964a263f3d4f07542fcf55ca3bf2c18c5fd94"},
    "session_id":{"type":"string","minLength":1},
    "mode":{"enum":["first_completion","revisit"]},
    "experiment":{
      "type":"object","additionalProperties":false,
      "required":["expectation_before","body_state_before","observation_recorded","perceived_change_after"],
      "properties":{
        "expectation_before":{"type":"integer","minimum":0,"maximum":10},
        "body_state_before":{"type":"integer","minimum":0,"maximum":10},
        "observation_recorded":{"const":true},
        "perceived_change_after":{"type":"integer","minimum":0,"maximum":10},
        "observation_vault_entry_ref":{"type":["string","null"]}
      }
    },
    "jachin":{
      "type":"object","additionalProperties":false,
      "required":["visualization_completed","duration_seconds","return_confirmed"],
      "properties":{
        "visualization_completed":{"const":true},
        "duration_seconds":{"type":"integer","minimum":0},
        "comfort_rating":{"type":["integer","null"],"minimum":0,"maximum":10},
        "return_confirmed":{"const":true}
      }
    },
    "audio_theta432":{
      "type":"object","additionalProperties":false,
      "required":["started","profile_id"],
      "properties":{
        "started":{"const":true},
        "profile_id":{"const":"HNK-THETA432-BINAURAL-V1"},
        "duration_seconds":{"type":["integer","null"],"minimum":0},
        "stopped_for_discomfort":{"type":"boolean"}
      }
    },
    "boaz":{
      "type":"object","additionalProperties":false,
      "required":["monitor_completed","duration_seconds","pattern_notices","trigger_recorded","return_confirmed"],
      "properties":{
        "monitor_completed":{"const":true},
        "duration_seconds":{"type":"integer","minimum":0},
        "pattern_notices":{"type":"integer","minimum":0},
        "trigger_recorded":{"const":true},
        "trigger_vault_entry_ref":{"type":["string","null"]},
        "return_confirmed":{"const":true}
      }
    },
    "middle":{
      "type":"object","additionalProperties":false,
      "required":["swish_completed","target_state_before","perceived_change_after","observation_recorded","return_confirmed"],
      "properties":{
        "swish_completed":{"const":true},
        "target_state_before":{"type":"integer","minimum":0,"maximum":10},
        "perceived_change_after":{"type":"integer","minimum":0,"maximum":10},
        "observation_recorded":{"const":true},
        "observation_vault_entry_ref":{"type":["string","null"]},
        "return_confirmed":{"const":true}
      }
    },
    "phenomenology":{"type":"array","uniqueItems":true,"items":{"enum":["WARMTH","CALM","IMAGERY","AGITATION","BODY_SENSATIONS","NO_NOTICEABLE_CHANGE","STRONG_EMOTION","OTHER"]}},
    "soul_mirror":{
      "type":"object","additionalProperties":false,
      "required":["completed"],
      "properties":{
        "completed":{"const":true},
        "difficulty_rating":{"type":["integer","null"],"minimum":0,"maximum":10},
        "vault_entry_ref":{"type":["string","null"]}
      }
    },
    "voluntary_completion_confirmed":{"const":true},
    "safety_stop_occurred":{"type":"boolean"}
  }
}
