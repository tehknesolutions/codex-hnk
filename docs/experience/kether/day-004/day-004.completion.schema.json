{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hnk.local/schemas/day-004.completion.schema.json",
  "title":"HNK Day 004 Completion Contract V1",
  "type":"object",
  "additionalProperties":false,
  "required":["completion_contract_id","quest_definition_id","day","session_id","evidence","voluntary_completion_confirmed"],
  "properties":{
    "completion_contract_id":{"const":"HNK-KETHER-D004-COMP-V1"},
    "quest_definition_id":{"const":"HNK-KETHER-D004-V1"},
    "day":{"const":4},
    "session_id":{"type":"string","format":"uuid"},
    "evidence":{"$ref":"day-004.evidence.schema.json"},
    "voluntary_completion_confirmed":{"const":true},
    "client_completion_id":{"type":["string","null"]},
    "client_completed_at":{"type":["string","null"],"format":"date-time"}
  }
}
