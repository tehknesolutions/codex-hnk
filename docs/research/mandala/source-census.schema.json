{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hnk://mandala/source-census/v0.1",
  "title": "HNK Mandala Source Census V0.1",
  "type": "object",
  "required": ["version", "assets"],
  "properties": {
    "version": {"const": "0.1"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetId", "status", "sourceLock"],
        "properties": {
          "assetId": {"type": "string", "pattern": "^HNK-MANDALA-SRC-[0-9]{4}$"},
          "status": {"enum": ["LOCATED", "BYTES_PENDING", "SOURCE_LOCKED", "REJECTED_DUPLICATE", "UNRESOLVED"]},
          "repositoryPath": {"type": ["string", "null"]},
          "evidenceRef": {"type": ["string", "null"]},
          "mimeType": {"type": ["string", "null"]},
          "width": {"type": ["integer", "null"], "minimum": 1},
          "height": {"type": ["integer", "null"], "minimum": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "provenance": {"type": ["string", "null"]},
          "variantOf": {"type": ["string", "null"]},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "sourceLock": {"type": "boolean"},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
