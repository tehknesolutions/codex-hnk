{
  "version": "2.0-candidate",
  "status": "E3_HNKP_NAMESPACE_EXTENSION_CANDIDATE",
  "profileId": "HNKP2-MANDALA-ADDR-BE",
  "extends": "HNKP1-MF-TUPLE-BE",
  "purpose": "Extend HNKP transport from MF-only tuple nodes to the E1/E2 Mandala address namespaces while preserving exact HNKP1 decoding for legacy MF-only packets.",
  "authorityBoundary": {
    "transport": "HNK_CANDIDATE",
    "semanticMeaning": "NONE",
    "linguisticAuthority": "HNK-KODE",
    "humanGateRequired": true
  },
  "compatibility": {
    "legacyMagic": "HNKP",
    "legacyVersion": 1,
    "legacyFlags": 1,
    "rule": "Every HNKP1 packet remains byte-for-byte unchanged and MUST be decoded by the V1 MF tuple decoder.",
    "v2PacketsUseVersion": 2
  },
  "v2BinaryLayout": [
    {"field":"magic","bytes":4,"encoding":"ASCII","value":"HNKP"},
    {"field":"version","bytes":1,"type":"u8","value":2},
    {"field":"flags","bytes":1,"type":"u8","value":2,"meaning":"MANDALA_ADDRESS_NODES"},
    {"field":"nodeCount","bytes":"varuint","v2Constraint":"0..127 encoded in one byte"},
    {"field":"nodes","bytes":"3*nodeCount","item":"namespace u8 + ordinal u16 BE"},
    {"field":"edges","bytes":"nodeCount-1","item":"u8 edge enum"},
    {"field":"checksum","bytes":4,"type":"CRC32 IEEE big-endian","coverage":"all preceding bytes"}
  ],
  "namespaceEnum": {
    "MF": 1,
    "CG": 2,
    "CR_T": 3,
    "CR_H": 4,
    "CR_D": 5,
    "HC": 255
  },
  "ordinalLaw": {
    "MF": {"range":"1..432","mapping":"(layer-1)*72 + sector"},
    "CG": {"range":"1..9","mapping":"CG index"},
    "CR_T": {"range":"1..3"},
    "CR_H": {"range":"1..7"},
    "CR_D": {"range":"1..12"},
    "HC": {"status":"RESERVED_NOT_ENCODABLE_IN_E3"}
  },
  "edgeEnum": {
    "ANGULAR_NEXT": 0,
    "ANGULAR_PREV": 1,
    "RADIAL_IN": 2,
    "RADIAL_OUT": 3,
    "CONTAINS": 4,
    "MEMBER_OF": 5,
    "ROSE_NEXT": 6,
    "ROSE_PREV": 7,
    "BRIDGE": 8,
    "TO_CHOIR": 9,
    "FROM_CHOIR": 10,
    "CHOIR_NEXT": 11,
    "CHOIR_PREV": 12
  },
  "edgeGovernance": {
    "allowedE2": [0,1,2,3,6,7,9,10,11,12],
    "reservedOrBlocked": [4,5,8],
    "rule": "Transport enum availability does not authorize a graph edge. Encoder MUST reject edges blocked by the active topology profile."
  },
  "decodeLaw": [
    "Read magic and version.",
    "If version=1, dispatch unchanged to HNKP1-MF-TUPLE-BE.",
    "If version=2, require flags=2.",
    "Read nodeCount.",
    "For each node read namespace u8 and ordinal u16 BE.",
    "Validate ordinal against namespace range.",
    "Reject HC namespace in E3.",
    "Read exactly nodeCount-1 edge bytes.",
    "Validate each transition against E2 topology, not merely against the enum.",
    "Recompute CRC32 and require equality.",
    "Return the exact ordered address PATH and edge sequence."
  ],
  "textTransport": {
    "v1Prefix": "HNKP1:",
    "v2Prefix": "HNKP2:",
    "encoding": "base64url without padding"
  },
  "securityAndIntegrity": {
    "crcPurpose": "accidental corruption detection only",
    "notAuthentication": true,
    "canonicalMeaningNotImplied": true
  },
  "nextGate": "E4_HNK40_GENESIS_PROJECTION"
}
