    "matrix": "4 rows × 10 columns",
    "rowFormula": "row = floor((g-1)/10)+1",
    "columnFormula": "column = ((g-1) mod 10)+1",
    "startSectorFormula": "sector1 = g",
    "startLayer": "L01"
  },
  "families": {
