  "wrapLaw": "All sector arithmetic is modulo 72 with human sector range S01..S72.",
  "projectionLaw": {
    "pixel": "x=sector1-1; y=layer1-1",
    "iso": "u=x-y; v=x+y",
    "voxel": "x=sector1-1; y=0; z=layer1-1",
    "mfTuple": "[LAY typed-frame hex16, SEC typed-frame hex16]"
  },
  "transportProfile": "HNKP1-MF-TUPLE-BE",
  "invariants": [
    "Exactly 40 candidate IDs are generated: G01..G40.",
    "Every candidate contains exactly five MF nodes and four legal MF edges.",
    "Every ordered PATH is unique.",
    "Every node round-trips through typed MF tuple, PixelMap, IsoPixel and Voxel.",
    "Every candidate can serialize through HNKP1-MF-TUPLE-BE and decode to the identical ordered PATH.",
    "No family rule assigns meaning, phoneme, sacred correspondence, color, sound or visual-canon status."
