{
  "version": "1.0-experimental",
  "status": "HNK_CANDIDATE_STRUCTURAL_SEED_FAMILY",
  "purpose": "Define a deterministic, non-semantic 40-member Glyph Genesis seed family for G01..G40 using the frozen Mandala MF topology. This is a structural search space, not canonical glyph art.",
  "authorityBoundary": {
