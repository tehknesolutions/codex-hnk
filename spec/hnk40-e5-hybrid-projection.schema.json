{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hnk-kode/hnk40-e5-hybrid-projection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "derivationRule", "summary", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "source": { "type": "object" },
    "derivationRule": { "type": "string", "minLength": 1 },
    "summary": { "type": "object" },
    "records": { "type": "array", "minItems": 40, "maxItems": 40, "items": { "$ref": "#/$defs/hybridProjectionRecord" } }
  },
  "$defs": {
    "legacyIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["glyphId", "sourceRef", "sourceFingerprint", "legacyPath", "authority"],
      "properties": {
        "glyphId": { "type": "string", "pattern": "^G(?:0[1-9]|[1-3][0-9]|40)$" },
        "sourceRef": { "type": "string", "minLength": 1 },
        "sourceFingerprint": { "type": ["string", "null"] },
        "legacyPath": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "authority": { "const": "HNK40_LEGACY" }
      }
    },
    "metrics": { "type": "object", "additionalProperties": false, "required": ["directionMismatchCount", "cyclicMandalaDistance"], "properties": { "directionMismatchCount": { "type": "integer", "minimum": 0 }, "cyclicMandalaDistance": { "type": "integer", "minimum": 0 } } },
    "e5Projection": {
      "type": "object", "additionalProperties": false,
      "required": ["projectionId", "path", "derivationRule", "metrics", "authority", "canonical"],
      "properties": {
        "projectionId": { "type": "string", "minLength": 1 },
        "path": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^MF-[A-Z0-9-]+$" } },
        "derivationRule": { "type": "string", "minLength": 1 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "authority": { "const": "DERIVED_STRUCTURAL" },
        "canonical": { "const": false }
      }
    },
    "hybridProjectionRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["legacyIdentity", "projectionSet", "resolutionStatus", "preferredProjectionId", "resolutionEvidence", "acquisitionEligibility"],
      "properties": {
        "legacyIdentity": { "$ref": "#/$defs/legacyIdentity" },
        "projectionSet": { "type": "array", "items": { "$ref": "#/$defs/e5Projection" } },
        "resolutionStatus": { "enum": ["DIRECT", "DERIVED_UNIQUE", "DERIVED_AMBIGUOUS", "NO_E5_PROJECTION", "PENDING_RULE"] },
        "preferredProjectionId": { "type": ["string", "null"] },
        "resolutionEvidence": { "type": ["object", "null"] },
        "acquisitionEligibility": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "resolutionStatus": { "const": "DERIVED_AMBIGUOUS" } }, "required": ["resolutionStatus"] }, "then": { "properties": { "preferredProjectionId": { "type": "null" } } } }
      ]
    }
  }
}
