{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hnk://schemas/knowledge-object-interoperability.v1",
  "title": "HNK Knowledge Object Interoperability V1",
  "type": "object",
  "required": ["id", "type", "title", "lifecycle", "authorityScope", "authorityLevel", "sources", "relations"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "lifecycle": {"enum": ["RAW", "OBSERVED", "EXPERIMENTAL", "REVIEWED", "APPROVED", "CANON", "REJECTED", "SUPERSEDED", "DEPRECATED", "ARCHIVED"]},
    "authorityScope": {"type": "string", "minLength": 1},
    "authorityLevel": {"enum": ["ROOT_CANON", "DOMAIN_CANON", "PRODUCT_CANON", "IMPLEMENTATION_AUTHORITY", "PROJECTION", "EVIDENCE_SOURCE", "HISTORICAL_SOURCE"]},
    "evidenceState": {"enum": ["UNVERIFIED", "OBSERVED", "TESTED", "VALIDATED", "CERTIFIED"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "projectScope": {"type": "string"},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "temporalScope": {"type": "object", "properties": {"observedAt": {"type": "string"}, "validFrom": {"type": "string"}, "validUntil": {"type": ["string", "null"]}}, "additionalProperties": false},
    "payload": {}
  },
  "$defs": {"relation": {"type": "object", "required": ["type", "target"], "properties": {"type": {"enum": ["ROOT_OF", "DOMAIN_CANON_FOR", "CONSUMES_CANON_FROM", "PUBLISHES_CONTRACT_TO", "MIGRATED_FROM", "INCUBATED_IN", "PROJECTS_INTO", "PRODUCES_EVIDENCE_FOR", "PEDAGOGICAL_PROJECTION_OF", "RUNTIME_PROJECTION_OF", "MUST_NOT_PROMOTE_TO_CANON", "IMPLEMENTS", "VALIDATED_BY", "SUPERSEDES", "DERIVED_FROM", "EXTRACTED_FROM", "REUSES"]}, "target": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
}
