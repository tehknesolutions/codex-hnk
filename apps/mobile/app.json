{
  "expo": {
    "name": "HNK Codex",
    "slug": "codex-hnk",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hnk",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tehknesolutions.codexhnk"
    },
    "android": {
      "package": "com.tehknesolutions.codexhnk"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que o HNK Codex use o microfone somente quando você iniciar uma prática de áudio, como o Acoustic Lab.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o HNK Codex use a câmera somente quando você iniciar a experiência AR do Dia 025.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
